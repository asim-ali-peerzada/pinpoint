<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Pinpoint">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Testbench bakes DB_FOREIGN_KEYS=false into its default config; real
             Laravel apps default to true. Enforce FKs so tests exercise the
             same cascadeOnDelete behavior production runs on. -->
        <env name="DB_FOREIGN_KEYS" value="true"/>
    </php>
</phpunit>
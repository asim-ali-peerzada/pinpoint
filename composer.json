{
    "name": "asimali/pinpoint",
    "description": "Pinpoint: local-first Laravel request performance profiler with N+1 detection, tiering, CLI report and CI regression gate",
    "keywords": [
        "laravel",
        "performance",
        "profiler",
        "n1",
        "queries",
        "telescope-alternative",
        "debugging"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Asim Ali",
            "email": "asimalipeerzada@gmail.com"
        }
    ],
    "homepage": "https://asim-ali-peerzada.github.io/pinpoint",
    "support": {
        "source": "https://github.com/asim-ali-peerzada/pinpoint/tree/main",
        "issues": "https://github.com/asim-ali-peerzada/pinpoint/issues",
        "docs": "https://asim-ali-peerzada.github.io/pinpoint"
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-arch": "^3.1|^4.0",
        "pestphp/pest-plugin-laravel": "^3.2|^4.1"
    },
    "autoload": {
        "psr-4": {
            "AsimAli\\Pinpoint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimAli\\Pinpoint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsimAli\\Pinpoint\\PinpointServiceProvider"
            ],
            "aliases": {
                "Pinpoint": "AsimAli\\Pinpoint\\Facades\\Pinpoint"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "benchmark": "php benchmarks/overhead.php",
        "format": "pint",
        "format:test": "pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

{
    "name": "asimali/pinpoint",
    "description": "Pinpoint: Laravel request performance collector, N+1 detection, tiering and CLI report",
    "license": "MIT",
    "authors": [
        {
            "name": "Asim Ali",
            "email": "asimalipeerzada@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/framework": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-arch": "^3.1",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "AsimAli\\Pinpoint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsimAli\\Pinpoint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AsimAli\\Pinpoint\\PinpointServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "benchmark": "php benchmarks/overhead.php",
        "format": "pint",
        "format:test": "pint --test"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

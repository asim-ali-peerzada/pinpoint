---
import Button from '../ui/Button.astro';
import { Copy } from 'lucide-react';
---

<header class="fixed top-0 left-0 right-0 z-50 h-14 border-b border-white/[0.08] bg-[#050608]/90 backdrop-blur-2xl transition-all duration-300">
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    
    <!-- Left: Brand + Get Started (unified visual unit) -->
    <div class="flex items-center gap-3 sm:gap-4 shrink-0">
      <a href="#" class="flex items-center gap-2.5 group">
        <div class="relative flex h-7 w-7 items-center justify-center rounded-lg bg-brand-accent/15 ring-1 ring-brand-accent/30 shadow-[0_0_12px_rgba(245,48,3,0.25)]">
          <span class="h-2.5 w-2.5 rounded-sm bg-brand-accent"></span>
          <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full border border-brand-bg bg-brand-accent">
            <span class="absolute inset-0 animate-ping rounded-full bg-brand-accent/70"></span>
          </span>
        </div>
        <span class="text-sm font-bold tracking-tight text-white group-hover:text-gray-200 transition-colors">
          Pinpoint
        </span>
      </a>
      <Button href="#docs" size="sm" variant="primary" class="hidden sm:inline-flex">
        Get started <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
      </Button>
    </div>

    <!-- Center: Navigation Links (Generous spacing, no overlap) -->
    <nav class="hidden items-center gap-6 lg:gap-8 text-[13px] font-medium text-gray-300 md:flex">
      <a href="#features" class="transition-colors hover:text-white">Capabilities</a>
      <a href="#ci" class="transition-colors hover:text-white">CI Gate</a>
      <a href="#diff" class="transition-colors hover:text-white">Comparison</a>
      <a href="#docs" class="transition-colors hover:text-white">Documentation</a>
    </nav>

    <!-- Right: Compact Command + GitHub -->
    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <!-- Compact Copyable Command (xl:flex) -->
      <button
        class="group hidden items-center gap-2 rounded-md border border-white/10 bg-white/[0.03] px-3 py-1 font-mono text-xs text-gray-300 transition-colors hover:border-white/20 hover:text-white xl:flex"
        data-copy="composer require asimali/pinpoint"
        title="Copy install command"
      >
        <span class="text-brand-accent select-none">$</span>
        <span class="truncate">composer require asimali/pinpoint</span>
        <Copy strokeWidth={1.25} class="h-3 w-3 text-gray-400 group-hover:text-white transition-colors" />
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com/asim-ali-peerzada/pinpoint"
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-8 w-8 items-center justify-center rounded-md border border-white/10 bg-white/[0.03] text-gray-400 transition-colors hover:border-white/20 hover:text-white"
        title="GitHub Repository"
        aria-label="GitHub Repository"
      >
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
      </a>
    </div>

  </div>
</header>

<style>
  button[data-copy][data-copied='true'] svg {
    color: theme('colors.brand.success');
  }
</style>

<script>
  function bindCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((el) => {
      if (el.dataset.bound) return;
      el.dataset.bound = 'true';
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.dataset.copy || '');
        } catch {}
        el.dataset.copied = 'true';
        setTimeout(() => (el.dataset.copied = 'false'), 1500);
      });
    });
  }

  bindCopyButtons();
  document.addEventListener('astro:after-swap', bindCopyButtons);
</script>

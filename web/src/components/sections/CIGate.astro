---
---

<section id="ci" class="relative py-20 sm:py-24 overflow-hidden scroll-mt-20">
  <div class="section-ambient pointer-events-none absolute inset-x-0 top-0 -z-10 h-[480px]"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 text-center">
    <!-- Eyebrow -->
    <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent font-mono">
      CI Regression Gate
    </p>

    <!-- Big Headline -->
    <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl text-balance">
      Fail CI when a recorded workload violates your performance budget.
    </h2>

    <!-- Subtitle -->
    <p class="mt-4 leading-relaxed text-gray-300 text-sm sm:text-base max-w-xl mx-auto text-pretty text-balance">
      Automate performance checks in CI. Exit with code 1 when query budgets explode or performance regresses against a named baseline.
    </p>

    <!-- 2-Column Split: Workflow YAML + Terminal Result -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-6 text-left items-stretch">
      <!-- Column 1: GitHub Actions YAML (5 cols) -->
      <div class="lg:col-span-5 rounded-2xl border border-white/10 bg-[#090B0E] p-5 shadow-xl flex flex-col justify-between font-mono text-xs">
        <div>
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-3 text-gray-400">
            <span class="text-gray-300 font-semibold">.github/workflows/ci.yml <span class="text-gray-500 font-normal">(Illustrative Recipe)</span></span>
            <span class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider">GitHub Actions</span>
          </div>

          <div class="mt-4 text-gray-300 space-y-1 leading-relaxed text-[11.5px] bg-[#040507] p-3.5 rounded-xl border border-white/5 overflow-x-auto">
            <div class="text-gray-500"># Step 1: Restore main branch baseline snapshot</div>
            <div>- <span class="text-cyan-300">name:</span> Restore Baseline</div>
            <div class="pl-4"><span class="text-cyan-300">uses:</span> actions/cache/restore@v4</div>
            <div class="pl-4"><span class="text-cyan-300">with:</span></div>
            <div class="pl-6 text-gray-300">path: storage/pinpoint/baselines/main.json</div>
            <div class="pl-6 text-gray-300">key: pinpoint-baseline-main</div>
            <div class="pt-2 text-gray-500"># Step 2: Run PR workload / test suite</div>
            <div>- <span class="text-cyan-300">name:</span> Run Tests</div>
            <div class="pl-4"><span class="text-cyan-300">run:</span> php artisan test</div>
            <div class="pt-2 text-gray-500"># Step 3: Compare PR against baseline</div>
            <div>- <span class="text-cyan-300">name:</span> Performance Gate</div>
            <div class="pl-4"><span class="text-cyan-300">run:</span> |</div>
            <div class="pl-6 text-brand-accent font-semibold">php artisan pinpoint:diff \</div>
            <div class="pl-8 text-gray-300">--baseline=storage/pinpoint/baselines/main.json \</div>
            <div class="pl-8 text-rose-400 font-semibold">--fail-on-regression</div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] text-gray-400">
          Baseline JSON exported on main via <code class="text-gray-300 font-mono">pinpoint:snapshot --file=storage/pinpoint/baselines/main.json</code> and cached for PR jobs. Decoupled from application database state.
        </div>
      </div>

      <!-- Column 2: Terminal Failure Result (7 cols) -->
      <div class="lg:col-span-7 rounded-2xl border border-white/15 bg-[#08090C] shadow-2xl ring-1 ring-white/5 overflow-hidden flex flex-col font-mono text-xs">
        <!-- Terminal header -->
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/[0.08] bg-[#0C0E12] px-3.5 sm:px-4 py-2.5 sm:py-3 shrink-0">
          <div class="flex items-center gap-2 min-w-0">
            <div class="h-2.5 w-2.5 rounded-full bg-[#EC6A5E]/80"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-[#F5BF4F]/80"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-[#62C554]/80"></div>
            <span class="ml-1 sm:ml-2 text-xs text-gray-300 font-sans font-medium truncate">GitHub Actions • Run #412</span>
          </div>
          <span class="rounded-full border border-rose-500/40 bg-rose-500/20 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-rose-300 shrink-0">
            Exit Code 1 • CI Check Failed
          </span>
        </div>

        <!-- Terminal body: starts right below header without empty space -->
        <div class="p-4 sm:p-6 space-y-4 leading-relaxed flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="text-gray-300 overflow-x-auto text-[11px] sm:text-xs">
              <span class="text-gray-500 select-none font-medium">$ </span>
              <span class="text-brand-accent font-semibold">php artisan</span>
              <span class="text-white font-medium"> pinpoint:diff</span>
              <span class="text-gray-400"> --baseline=storage/pinpoint/baselines/main.json --fail-on-regression</span>
            </div>

            <div class="pt-1 text-rose-400 font-bold flex flex-wrap items-center gap-2 text-xs sm:text-sm leading-none">
              <span>✗ REGRESSION:</span>
              <span class="text-white font-semibold break-all">api.orders.index</span>
            </div>

            <div class="pl-3 sm:pl-4 border-l-2 border-rose-500 bg-rose-950/20 rounded-r-lg p-3 space-y-1.5 text-[11.5px]">
              <div class="text-rose-300 font-medium">
                <span class="text-rose-400 font-bold">N+1 Introduced: </span> none (baseline) → 14× loop (current) · p95 +32.4%
              </div>
              <div class="text-gray-300">
                Relationship <code class="text-white">Order → items</code> lazy-loaded inside collection loop.
              </div>
              <div class="text-gray-400 text-[11px] pt-0.5 break-all">
                Trigger: <span class="text-gray-200">app/Http/Controllers/OrderController.php:84</span>
              </div>
            </div>
          </div>

          <div class="mt-2 border-t border-white/5 pt-3 text-xs text-gray-400 flex flex-col sm:flex-row sm:items-center justify-between gap-1 shrink-0">
            <span>PR status set to <strong class="text-rose-400">failure</strong>. Exit code 1 (blocks merge).</span>
            <span class="text-gray-500 text-[11px] shrink-0">0.14s duration</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

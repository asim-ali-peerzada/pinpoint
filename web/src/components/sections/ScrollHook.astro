---
---

<section id="delta" class="relative py-20 sm:py-24 overflow-hidden scroll-mt-20">
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 h-72 w-full max-w-5xl bg-brand-accent/[0.04] blur-[120px]"></div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 space-y-10">

    <!-- Section 1: The AI & PR Silent Regression Hook -->
    <div class="rounded-2xl border border-white/10 bg-[#090B0E] p-6 sm:p-8 shadow-2xl relative overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-4">
        <div>
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-brand-accent">The Silent Regression Problem</span>
          <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-white">
            When a refactor silently changes query behavior
          </h2>
        </div>
        <span class="shrink-0 rounded-full bg-rose-500/15 border border-rose-500/30 px-3 py-1 text-xs font-mono font-bold text-rose-300">
          2 queries → 51 queries
        </span>
      </div>

      <div class="mt-5 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <!-- Code diff block -->
        <div class="lg:col-span-7 bg-[#040507] p-4 rounded-xl border border-white/[0.06] font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 pb-1.5 border-b border-white/[0.05] text-[11px]">app/Http/Controllers/OrderController.php</div>
          <div class="pt-2 text-rose-300 bg-rose-500/10 -mx-2 px-2 py-0.5 rounded-md">
            - $orders = Order::with('customer')-&gt;paginate(50);
          </div>
          <div class="text-emerald-300 bg-emerald-500/10 -mx-2 px-2 py-0.5 rounded-md mt-0.5">
            + $orders = Order::paginate(50);
          </div>
          <div class="text-gray-500 text-[11px] pt-2">
            // Refactored by assistant: tests still pass, app renders fine.
          </div>
        </div>

        <!-- Explanation bullets -->
        <div class="lg:col-span-5 space-y-2.5 text-xs text-gray-300">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>Tests pass</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>Response is correct</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-rose-400 font-bold">✗</span>
            <span class="font-semibold text-rose-300">Query count: 2 → 51</span>
          </div>
          <p class="pt-1 text-[11.5px] leading-relaxed text-gray-400 border-t border-white/[0.06]">
            <code class="text-white font-mono">pinpoint:diff</code> compares recorded PR metrics against a baseline snapshot (<code class="text-white font-mono">main</code>) and exits 1 on regression.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 2: Real Workload Benchmark Delta Card -->
    <div class="overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0A0C10] shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
      <!-- Top Card Header -->
      <div class="flex items-center justify-between gap-3 border-b border-white/[0.06] bg-[#0E1015] px-5 py-3.5">
        <div class="flex min-w-0 items-center gap-2.5">
          <span class="h-2 w-2 shrink-0 rounded-full bg-brand-accent animate-pulse"></span>
          <span class="truncate font-mono text-xs font-semibold text-white">GET /api/orders</span>
          <span class="hidden sm:inline-block font-mono text-xs text-gray-600">·</span>
          <span class="hidden sm:inline-block truncate font-mono text-xs text-gray-400">OrderController@index</span>
        </div>

        <span class="shrink-0 rounded-full border border-emerald-500/30 bg-emerald-950/40 px-2.5 py-0.5 font-mono text-xs font-semibold text-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
          Measured after eager loading
        </span>
      </div>

      <!-- Before / After 2-Column Split -->
      <div class="grid grid-cols-1 divide-y divide-white/[0.06] sm:grid-cols-2 sm:divide-y-0 sm:divide-x">
        <!-- Before -->
        <div class="p-6 sm:p-7 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 font-mono">Before eager loading</span>
          </div>
          <div>
            <div class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-red-500 tabular-nums">
              1,420<span class="text-base sm:text-lg font-normal text-gray-500 ml-1">ms</span>
            </div>
            <p class="mt-2 font-mono text-xs text-gray-400">
              <span class="text-gray-200 font-medium">42 queries</span> · 14× lazy-loaded relations
            </p>
          </div>
        </div>

        <!-- After -->
        <div class="p-6 sm:p-7 space-y-3 bg-white/[0.015]">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 font-mono">After eager loading</span>
          </div>
          <div>
            <div class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-emerald-400 tabular-nums">
              89<span class="text-base sm:text-lg font-normal text-gray-500 ml-1">ms</span>
            </div>
            <p class="mt-2 font-mono text-xs text-gray-400">
              <span class="text-gray-200 font-medium">3 queries</span> · <code class="text-emerald-300">Order::with('items')</code>
            </p>
          </div>
        </div>
      </div>

      <!-- Bottom Resolution Summary with Factual Workload Label -->
      <div class="border-t border-white/[0.06] bg-[#07080B] px-5 py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-gray-300">
        <span>Example measurement: <strong class="text-gray-200">1,420 ms → 89 ms</strong> (42 queries → 3 queries) after adding eager loading on local PHP 8.3 / MySQL 8.0 (50 records).</span>
        <span class="text-gray-400 font-mono text-[11px]">Inspect the recorded workload with <code class="text-gray-300">pinpoint:report</code></span>
      </div>
    </div>

    <!-- Section 3: Exact Duplicate vs N+1 Candidate Distinction -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Card A: Exact Duplicate -->
      <div class="rounded-xl border border-cyan-500/25 bg-cyan-950/15 p-5 space-y-3">
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-cyan-500/20 border border-cyan-500/40 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-cyan-300">
            REPEATED QUERY
          </span>
          <span class="text-[11px] font-mono text-gray-400">bindings_hash match</span>
        </div>
        <div>
          <p class="font-mono text-xs text-white font-medium">Identical SQL + Identical Bindings</p>
          <p class="mt-1 text-xs text-gray-300 leading-relaxed">
            Same query executed multiple times during the request. Review whether the result can be reused or avoided.
          </p>
        </div>
        <div class="pt-2 border-t border-cyan-500/20 text-xs font-mono text-cyan-300">
          Possible action: <code class="bg-black/50 px-2 py-0.5 rounded-md text-white border border-cyan-500/30">Cache::remember()</code>, memoization, or query reuse
        </div>
      </div>

      <!-- Card B: N+1 Candidate -->
      <div class="rounded-xl border border-rose-500/25 bg-rose-950/15 p-5 space-y-3">
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-rose-500/20 border border-rose-500/40 px-2.5 py-0.5 font-mono text-[11px] font-bold uppercase text-rose-300">
            N+1 CANDIDATE
          </span>
          <span class="text-[11px] font-mono text-gray-400">varying bindings</span>
        </div>
        <div>
          <p class="font-mono text-xs text-white font-medium">Repeated SQL + Varying Bindings</p>
          <p class="mt-1 text-xs text-gray-300 leading-relaxed">
            Repeated SQL with varying bindings can indicate a relationship being loaded once per model.
          </p>
        </div>
        <div class="pt-2 border-t border-rose-500/20 text-xs font-mono text-rose-300">
          Possible action: eager load the relationship with <code class="bg-black/50 px-2 py-0.5 rounded-md text-white border border-rose-500/30">Model::with('relation')</code>
        </div>
      </div>
    </div>

  </div>
</section>

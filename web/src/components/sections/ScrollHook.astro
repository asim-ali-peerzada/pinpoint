---
---

<section id="delta" class="relative py-12 sm:py-16 overflow-hidden scroll-mt-20">
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 h-48 w-full max-w-3xl bg-brand-accent/[0.05] blur-[100px]"></div>

  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <!-- Structured Performance Delta Card -->
    <div class="overflow-hidden rounded-2xl border border-white/[0.08] bg-[#0A0C10] shadow-[0_20px_60px_rgba(0,0,0,0.6)]">
      
      <!-- Top Card Header -->
      <div class="flex items-center justify-between border-b border-white/[0.06] bg-[#0E1015] px-5 py-3.5">
        <div class="flex items-center gap-2.5">
          <span class="h-2 w-2 rounded-full bg-brand-accent animate-pulse"></span>
          <span class="font-mono text-xs font-semibold text-white">GET /api/orders</span>
          <span class="hidden sm:inline-block font-mono text-xs text-gray-600">·</span>
          <span class="hidden sm:inline-block font-mono text-xs text-gray-400">OrderController@index</span>
        </div>
        
        <span class="rounded-full border border-emerald-500/30 bg-emerald-950/40 px-2.5 py-0.5 font-mono text-xs font-semibold text-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.15)]">
          -93.7% latency
        </span>
      </div>

      <!-- Before / After 2-Column Split -->
      <div class="grid grid-cols-1 divide-y divide-white/[0.06] sm:grid-cols-2 sm:divide-y-0 sm:divide-x">
        <!-- Before -->
        <div class="p-6 sm:p-7 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-500 font-mono">Unoptimized (N+1)</span>
            <span class="rounded bg-rose-500/10 px-2 py-0.5 text-[10px] font-bold uppercase text-rose-400 font-mono">Critical</span>
          </div>
          <div>
            <div class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-red-500 tabular-nums">
              1,420<span class="text-base sm:text-lg font-normal text-gray-500 ml-1">ms</span>
            </div>
            <p class="mt-2 font-mono text-xs text-gray-400">
              <span class="text-gray-200 font-medium">42 queries</span> · 14× lazy-loaded relations
            </p>
          </div>
        </div>

        <!-- After -->
        <div class="p-6 sm:p-7 space-y-3 bg-white/[0.015]">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 font-mono">Resolved via Pinpoint</span>
            <span class="rounded bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-400 font-mono">Optimized</span>
          </div>
          <div>
            <div class="font-mono text-4xl sm:text-5xl font-bold tracking-tight text-emerald-400 tabular-nums">
              89<span class="text-base sm:text-lg font-normal text-gray-500 ml-1">ms</span>
            </div>
            <p class="mt-2 font-mono text-xs text-gray-400">
              <span class="text-gray-200 font-medium">3 queries</span> · <code class="text-emerald-300">Order::with('items')</code>
            </p>
          </div>
        </div>
      </div>

      <!-- Bottom Resolution Summary with Factual Workload Label -->
      <div class="border-t border-white/[0.06] bg-[#07080B] px-5 py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-gray-400">
        <span>Workload: <strong class="text-gray-300">1,000 Order records</strong> iterated on local PHP 8.3 / MySQL.</span>
        <span class="text-gray-500 font-mono text-[11px]">Found in seconds via pinpoint:report</span>
      </div>

    </div>
  </div>
</section>

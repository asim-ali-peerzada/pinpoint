---
import { ArrowUpRight, Github } from 'lucide-react';

const navigation = {
  highlights: [
    { label: 'Capabilities', href: '#features' },
    { label: 'Workload Proof', href: '#delta' },
    { label: 'Companion Matrix', href: '#comparison' },
    { label: 'N+1 Query Detection', href: '#features' },
  ],
  resources: [
    { label: 'Documentation', href: '#docs' },
    { label: 'CI Regression Gate', href: '#ci' },
    { label: 'Releases & Changelog', href: 'https://github.com/asim-ali-peerzada/pinpoint/releases', external: true },
    { label: 'Packagist Package', href: 'https://packagist.org/packages/asimali/pinpoint', external: true },
  ],
  ecosystem: [
    { label: 'Laravel 12 (PHP 8.2+)' },
    { label: 'Laravel 13 (PHP 8.3+)' },
    { label: 'MySQL, PostgreSQL, SQLite' },
    { label: 'Companion Matrix', href: '#comparison' },
  ],
  community: [
    { label: 'Issue Tracker', href: 'https://github.com/asim-ali-peerzada/pinpoint/issues', external: true },
    { label: 'Contributing Guide', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/CONTRIBUTING.md', external: true },
    { label: 'Security Policy', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/SECURITY.md', external: true },
    { label: 'MIT License', href: 'https://github.com/asim-ali-peerzada/pinpoint/blob/main/LICENSE', external: true },
  ],
};
---

<footer class="relative z-10 mt-32 border-t border-white/[0.08] bg-black/60 backdrop-blur-xl">
  <!-- Subtle ambient background glow -->
  <div class="pointer-events-none absolute -top-32 left-1/2 -z-10 h-64 w-full max-w-5xl -translate-x-1/2 bg-brand-accent/[0.05] blur-[120px]"></div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pb-24">
    <!-- Brand Bio Section -->
    <div class="flex flex-col items-start gap-4">
      <div class="flex items-center gap-3">
        <div class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-brand-accent/15 ring-1 ring-brand-accent/30 shadow-[0_0_16px_rgba(245,48,3,0.3)]">
          <span class="h-2.5 w-2.5 rounded-sm bg-brand-accent"></span>
          <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full border border-black bg-brand-accent">
            <span class="absolute inset-0 animate-ping rounded-full bg-brand-accent/70"></span>
          </span>
        </div>
        <span class="font-display text-xl font-bold tracking-tight text-white">Pinpoint</span>
        <a
          href="https://github.com/asim-ali-peerzada/pinpoint/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-white/10 bg-white/[0.05] px-2.5 py-0.5 font-mono text-[11px] font-medium text-gray-400 hover:text-white transition-colors"
        >
          Releases on GitHub ↗
        </a>
      </div>

      <!-- Constrained paragraph block -->
      <p class="max-w-md text-sm leading-relaxed text-gray-400">
        Pinpoint identifies slow routes and N+1 queries in your Laravel application from your terminal, pointing directly to the exact file and line to fix. Local-first: request data stays in your application database.
      </p>
    </div>

    <!-- Navigation Columns Grid (equal-width columns, flush full width) -->
    <div class="mt-14 grid grid-cols-2 gap-8 border-t border-white/[0.14] pt-10 md:grid-cols-4 lg:gap-10">
      <!-- Highlights -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-200">Highlights</p>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.highlights.map((item) => (
            <li class="flex items-center h-6">
              <a href={item.href} class="text-gray-400 transition-colors duration-150 hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-200">Resources</p>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.resources.map((item) => (
            <li class="flex items-center h-6">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-1 text-gray-400 transition-colors duration-150 hover:text-white"
              >
                <span>{item.label}</span>
                {item.external && (
                  <ArrowUpRight strokeWidth={1.5} class="h-3.5 w-3.5 text-gray-500 transition-colors duration-150 group-hover:text-white shrink-0" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Ecosystem -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-200">Ecosystem</p>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.ecosystem.map((item) => (
            <li class="flex items-center h-6">
              {item.href ? (
                <a href={item.href} class="text-gray-400 transition-colors duration-150 hover:text-white">
                  {item.label}
                </a>
              ) : (
                <span class="text-gray-400">{item.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Community (flush right, aligns with View-source / credit bars below) -->
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-200">Community</p>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.community.map((item) => (
            <li class="flex items-center h-6">
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class="group inline-flex items-center gap-1 text-gray-400 transition-colors duration-150 hover:text-white"
              >
                <span>{item.label}</span>
                {item.external && (
                  <ArrowUpRight strokeWidth={1.5} class="h-3.5 w-3.5 text-gray-500 transition-colors duration-150 group-hover:text-white shrink-0" />
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Attribution Bar -->
    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/[0.08] pt-8 text-xs text-gray-400 sm:flex-row">
      <p>
        Pinpoint is open-sourced software licensed under the <a href="https://github.com/asim-ali-peerzada/pinpoint/blob/main/LICENSE" class="text-gray-300 hover:text-white underline">MIT license</a>. Laravel is a registered trademark of Taylor Otwell.
      </p>

      <a
        href="https://github.com/asim-ali-peerzada/pinpoint"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-gray-400 transition-colors duration-150 hover:text-white"
      >
        <Github class="h-4 w-4" />
        <span>View source on GitHub</span>
      </a>
    </div>

    <!-- Copyright & Developer Credit -->
    <div class="mt-6 flex flex-col items-center justify-between gap-2 border-t border-white/[0.06] pt-6 text-xs text-gray-500 sm:flex-row">
      <p>© {new Date().getFullYear()} Pinpoint. All rights reserved.</p>
      <p>
        Created by <a
          href="https://github.com/asim-ali-peerzada"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-300 hover:text-white transition-colors"
        >Asim Ali Peerzada</a>
      </p>
    </div>
  </div>
</footer>

---
import GlowMesh from '../ui/GlowMesh.astro';
import Button from '../ui/Button.astro';
import InstallSnippet from './InstallSnippet.astro';
import { Copy } from 'lucide-react';

const steps = [
  {
    n: '01',
    rawCmd: 'composer require asimali/pinpoint',
    label: 'Install the package',
    html: '<span class="text-brand-accent font-semibold">composer</span> <span class="text-white">require</span> <span class="text-white font-medium">asimali/pinpoint</span>',
  },
  {
    n: '02',
    rawCmd: 'php artisan vendor:publish --tag="pinpoint-migrations" && php artisan migrate',
    label: 'Publish & run migrations',
    html: '<span class="text-brand-accent font-semibold">php artisan</span> <span class="text-white">vendor:publish</span> <span class="text-gray-400">--tag=</span><span class="text-emerald-400">"pinpoint-migrations"</span> <span class="text-amber-400 font-bold">&amp;&amp;</span> <span class="text-brand-accent font-semibold">php artisan</span> <span class="text-white">migrate</span>',
  },
  {
    n: '03',
    rawCmd: 'php artisan pinpoint:report',
    label: 'Generate your first latency report',
    html: '<span class="text-brand-accent font-semibold">php artisan</span> <span class="text-white font-semibold">pinpoint:report</span>',
    hint: 'After running migrations, hit the routes you want to profile — via browser, curl, or tests — to generate data for the report.'
  },
];

const coreToolkit = [
  {
    cmd: 'pinpoint:report',
    tag: 'Interactive Diagnostic',
    desc: 'Generate terminal summary tables with latency rollups (p50/p95/p99/avg), peak memory per route with budget alerts, N+1 vs CACHE classification (exact-duplicate detection), terminal IDE links, and machine-readable JSON payloads.',
    flags: ['--tier=critical', '--route=<name>', '--since=30m', '--limit=10', '--json', '--json-to=<file>'],
    featured: true,
  },
  {
    cmd: 'pinpoint:diff',
    tag: 'Baseline Diffing',
    desc: 'Compare current test run performance against a baseline snapshot (main). Flags regressions in p95 latency, repeated-query increases, and peak memory in terminal and CI with exit code 1.',
    flags: ['--baseline=main', '--since=30m', '--fail-on-regression', '--json', '--show-stable'],
    featured: true,
  },
  {
    cmd: 'pinpoint:check',
    tag: 'CI Performance Gate',
    desc: 'Evaluate query counts, durations, and repeated-query violations (N+1 candidates and duplicate queries) as an automated CI gate, exiting with code 1 upon violation.',
    flags: ['--fail-on-n1', '--fail-on-repeat', '--max-queries=<n>', '--max-duration-ms=<ms>', '--since=30m', '--allow-empty', '--json', '--json-to=<file>'],
  },
  {
    cmd: 'pinpoint:snapshot',
    tag: 'Baseline Capture',
    desc: 'Capture current performance metrics as a named baseline tag or exported JSON file for future regression diffing (e.g. before merging to main).',
    flags: ['--tag=main', '--file=<path.json>', '--since=1h', '--no-overwrite'],
  },
];

const maintenanceToolkit = [
  {
    cmd: 'pinpoint:aggregate',
    desc: 'Compute raw request rollups and persist an offline percentile snapshot in pinpoint_summaries for external tools or reporting integrations (CLI reports compute on-demand from raw rows).',
    flags: [],
  },
  {
    cmd: 'pinpoint:prune',
    desc: 'Delete recorded request and query data older than the retention window (default 30 days).',
    flags: ['--days=30'],
  },
  {
    cmd: 'pinpoint:reset',
    desc: 'Delete all recorded Pinpoint data (requests, queries, lazy loads, summaries) with confirmation prompt.',
    flags: ['--force'],
  },
];
---

<section id="docs" class="relative py-20 sm:py-24 scroll-mt-16">
  <div class="section-ambient pointer-events-none absolute inset-x-0 top-0 -z-10 h-[480px]"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-brand-accent font-mono">Quickstart & Commands</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl text-balance">Get started in minutes.</h2>
      <p class="mt-4 leading-relaxed text-gray-300 text-sm sm:text-base max-w-lg mx-auto text-pretty text-balance">
        Install, migrate, run your app. Then one command tells you what's slow.
      </p>
    </div>

    <!-- Clean Commands Cards -->
    <div class="mt-14 space-y-4">
      {steps.map((s) => (
        <div class="group rounded-xl border border-white/[0.09] bg-[#0D0F12] p-4 sm:p-5 transition-all duration-200 hover:border-white/[0.18] hover:bg-[#101317] shadow-xl">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <span class="flex h-6 w-6 sm:h-7 sm:w-7 shrink-0 items-center justify-center rounded-md bg-brand-accent/15 font-mono text-[11px] sm:text-xs font-bold text-brand-accent">
                {s.n}
              </span>
              <p class="min-w-0 text-[11px] sm:text-xs font-semibold uppercase tracking-[0.14em] text-gray-200 font-sans leading-snug">
                {s.label}
              </p>
            </div>

            <button
              data-step-copy={s.rawCmd}
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/[0.03] text-gray-400 transition-colors hover:bg-white/[0.08] hover:text-white active:scale-95 cursor-pointer"
              title="Copy command"
              aria-label={`Copy command: ${s.rawCmd}`}
            >
              <Copy class="h-3.5 w-3.5" />
            </button>
          </div>

          <div class="mt-3 flex items-center justify-between gap-2 overflow-x-auto rounded-lg bg-[#050608] px-3.5 py-2.5 font-mono text-xs border border-white/5">
            <code class="whitespace-nowrap select-all text-gray-300 font-medium" set:html={s.html} />
          </div>

          {s.hint && (
            <p class="mt-2.5 text-[11px] text-gray-400 font-sans">
              {s.hint}
            </p>
          )}
        </div>
      ))}
    </div>

    <!-- Core Artisan Commands -->
    <div class="mt-16">
      <div class="text-center max-w-xl mx-auto">
        <h3 class="text-xl font-bold text-white tracking-tight text-balance">Core Artisan Commands</h3>
        <p class="mt-2 text-xs sm:text-sm text-gray-400 text-pretty text-balance">The essential commands for local diagnostics, CI gating, and baseline diffing.</p>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
        {coreToolkit.map((t) => (
          <div class:list={[
            'rounded-xl border border-white/10 bg-[#0A0C10] p-4 sm:p-5 space-y-3 shadow-lg overflow-hidden transition-all duration-200 hover:border-white/20 hover:bg-[#0E1117] hover:shadow-2xl',
            t.featured && 'md:col-span-2',
          ]}>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="font-mono text-sm sm:text-[15px] font-bold text-white flex items-center gap-2 min-w-0">
                <span class="text-gray-500 font-normal select-none shrink-0">$</span>
                <span class="text-brand-fg">php artisan <span class="text-brand-accent">{t.cmd}</span></span>
              </div>
              {t.tag && (
                <span class="rounded-md bg-amber-500/10 text-amber-400/90 px-2 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider whitespace-nowrap shrink-0 w-fit">
                  {t.tag}
                </span>
              )}
            </div>
            <p class="text-gray-300 font-sans text-xs sm:text-sm leading-relaxed max-w-2xl">
              {t.desc}
            </p>
            <div class="rounded-lg border border-white/[0.06] bg-black/20 px-3 py-2.5 flex flex-wrap items-center gap-x-2 gap-y-1.5">
              <span class="text-gray-500 text-[10px] font-semibold uppercase tracking-wider mr-1">Flags</span>
              {t.flags.map((f) => (
                <code class="rounded bg-white/[0.05] px-2 py-0.5 font-mono text-[10.5px] sm:text-[11px] text-gray-200 leading-relaxed">
                  {f}
                </code>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Collapsible Maintenance Commands -->
      <details class="group mt-6 rounded-xl border border-white/[0.08] bg-[#0A0C10]/60 p-4 transition-colors hover:border-white/15">
        <summary class="cursor-pointer list-none flex items-center justify-between text-xs font-mono text-gray-400 hover:text-white select-none">
          <span class="font-semibold text-gray-300">Maintenance Commands (aggregate, prune, reset)</span>
          <span class="text-[11px] text-gray-500 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 pt-3 border-t border-white/[0.06]">
          {maintenanceToolkit.map((m) => (
            <div class="rounded-lg border border-white/5 bg-black/30 p-3.5 space-y-2">
              <div class="font-mono text-xs font-bold text-white">
                php artisan <span class="text-brand-accent">{m.cmd}</span>
              </div>
              <p class="text-gray-400 text-[11px] leading-relaxed">
                {m.desc}
              </p>
              {m.flags.length > 0 && (
                <div class="flex flex-wrap gap-1 pt-1">
                  {m.flags.map((f) => (
                    <code class="rounded bg-white/[0.05] px-1.5 py-0.2 font-mono text-[10px] text-gray-300">
                      {f}
                    </code>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>

<!-- Final Call to Action Section -->
<section class="relative py-20 sm:py-24 overflow-hidden">
  <GlowMesh />
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6">
    <div class="rounded-2xl border border-brand-accent/30 bg-gradient-to-b from-[#161A22] to-[#0A0C10] p-8 sm:p-12 text-center shadow-[0_24px_70px_rgba(0,0,0,0.8)] ring-1 ring-white/10 relative overflow-hidden">
      <div class="absolute -top-24 -right-24 h-48 w-48 rounded-full bg-brand-accent/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 h-48 w-48 rounded-full bg-brand-accent/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
          Start profiling your Laravel routes today.
        </h3>
        <p class="text-sm text-gray-300 leading-relaxed max-w-xl mx-auto">
          Local-first: request data stays in your application database. Install, exercise a route, and inspect the resulting report.
        </p>

        <!-- Focused 2-CTA Row -->
        <div class="mx-auto pt-4 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <Button href="#docs">
            Get started <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
          </Button>
          <Button
            href="https://github.com/asim-ali-peerzada/pinpoint"
            target="_blank"
            rel="noopener noreferrer"
            variant="ghost"
            class="border border-white/15 rounded-md px-5 py-2.5 text-[15px] text-gray-300 hover:text-white hover:border-white/30 hover:bg-white/[0.04]"
          >
            View on GitHub
          </Button>
        </div>

        <!-- Quick install snippet -->
        <div class="mt-6 flex justify-center">
          <InstallSnippet command="composer require asimali/pinpoint" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  button[data-step-copy][data-copied='true'] [data-icon-copy] {
    color: theme('colors.brand.success');
  }
</style>

<script>
  function bindStepCopy() {
    document.querySelectorAll('[data-step-copy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-step-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {}
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.dataset.copied = 'false';
        }, 1600);
      });
    });
  }
  bindStepCopy();
  document.addEventListener('astro:after-swap', bindStepCopy);
</script>

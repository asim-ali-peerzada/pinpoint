---
import GlowMesh from '../ui/GlowMesh.astro';
import Button from '../ui/Button.astro';
import TerminalPreview from './TerminalPreview.astro';
import InstallSnippet from './InstallSnippet.astro';
import { ArrowRight } from 'lucide-react';
---

<section class="relative overflow-hidden pt-36 pb-12 sm:pt-44 sm:pb-16">
  <GlowMesh />

  <div class="relative z-10 mx-auto max-w-5xl px-4 text-center">
    <p class="text-xs sm:text-sm font-medium uppercase tracking-[0.16em] text-brand-accent font-mono whitespace-nowrap">
      Laravel performance, in your terminal
    </p>

    <!-- Responsive Balanced Headline: 2 clean lines on lg, natural phrases on mobile -->
    <h1 class="mx-auto mt-5 max-w-5xl text-balance text-3xl font-semibold leading-[1.12] tracking-tight text-brand-fg sm:text-5xl lg:text-[56px] xl:text-6xl sm:tracking-[-0.035em]">
      <span class="sm:whitespace-nowrap">Inspect Laravel performance locally.</span>
      <span class="block sm:inline font-bold text-white sm:whitespace-nowrap sm:before:content-['\a'] sm:before:whitespace-pre">Catch regressions in CI.</span>
    </h1>

    <!-- Balanced, Widow-Free Subheadline -->
    <p class="mx-auto mt-6 max-w-xl text-sm sm:text-base md:text-lg leading-relaxed text-brand-muted text-balance">
      Find slow routes, repeated queries, and performance regressions from your local test workload.
    </p>

    <!-- Focused 2-CTA Row -->
    <div class="mx-auto mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href="#docs">Get started <span class="transition-transform duration-200 group-hover:translate-x-0.5">→</span></Button>
      <Button
        href="https://github.com/asim-ali-peerzada/pinpoint#readme"
        target="_blank"
        rel="noopener"
        variant="ghost"
        class="border border-white/10 rounded-md px-5 py-2.5 text-[15px] text-gray-400 hover:text-white hover:border-white/20 hover:bg-white/[0.04]"
      >Read the docs</Button>
    </div>

    <!-- Quick install snippet -->
    <div class="mt-4 flex justify-center">
      <InstallSnippet />
    </div>

    <!-- Compatibility & License Strip -->
    <div class="mt-6 flex justify-center px-4">
      <div class="inline-flex items-center justify-center whitespace-nowrap gap-2 sm:gap-3 rounded-full border border-white/10 bg-[#0C0E12]/95 px-3 py-1.5 sm:px-4 shadow-[0_4px_24px_rgba(0,0,0,0.5)] backdrop-blur-md text-[11px] sm:text-xs font-mono">
        <span class="text-gray-300">Laravel 12 · PHP 8.2+</span>
        <span class="h-1 w-1 rounded-full bg-gray-600/80"></span>
        <span class="text-gray-300">Laravel 13 · PHP 8.3+</span>
        <span class="h-1 w-1 rounded-full bg-gray-600/80"></span>
        <a
          href="https://github.com/asim-ali-peerzada/pinpoint/blob/main/LICENSE"
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-gray-200 transition-colors"
        >
          MIT<span class="hidden sm:inline"> License</span>
        </a>
      </div>
    </div>

    <!-- Primary Interactive Demo Terminal -->
    <div class="mx-auto mt-14 max-w-5xl">
      <TerminalPreview />
    </div>

    <!-- Overhead Proof Note -->
    <div class="mx-auto mt-12 max-w-xl text-center">
      <div class="mx-auto mb-6 h-px w-24 bg-white/10"></div>
      <p class="text-[11px] uppercase tracking-[0.16em] text-gray-400 font-mono">Measured Runtime Overhead</p>
      <p class="mt-1 text-sm leading-6 text-brand-muted">
        In benchmark testing, in-memory query and route listening added <span class="font-mono font-medium text-brand-fg">~0.3–0.4 <span class="text-gray-500">ms</span></span>
        per request across 200 requests (10 queries/req in included Testbench suite). Persistence writes are deferred to Laravel <code class="text-gray-200 font-mono">terminating</code> callbacks after HTTP dispatch.
      </p>
    </div>

    <!-- Directional Scroll Cue -->
    <div class="mt-8 flex flex-col items-center justify-center gap-1.5 text-xs font-mono text-gray-400">
      <a href="#delta" class="inline-flex items-center gap-1 hover:text-white transition-colors">
        <span>See the example workload proof</span>
        <ArrowRight class="h-3 w-3 text-brand-accent" />
      </a>
    </div>

  </div>
</section>

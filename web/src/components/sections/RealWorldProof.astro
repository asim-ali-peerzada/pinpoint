---
import { AlertTriangle, Zap, ShieldCheck } from 'lucide-react';
import cliScreenshot from '../../assets/terminal-cli.png';
---

<section id="proof" class="relative py-20 sm:py-24 overflow-hidden scroll-mt-20">
  <!-- Unified level-2 ambient (same as Core Capabilities / CI Gate) -->
  <div class="section-ambient pointer-events-none absolute inset-x-0 top-0 -z-10 h-[480px]"></div>
  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-accent/20 bg-brand-accent/10 px-3 py-1 text-xs font-mono text-brand-accent mb-4">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-accent animate-pulse"></span>
        Workload Proof
      </div>
      <h2 class="text-3xl font-semibold tracking-tight text-brand-fg sm:text-4xl text-balance">
        Example output from a Laravel application.
      </h2>
      <p class="mt-4 leading-relaxed text-gray-300 text-sm sm:text-base max-w-xl mx-auto text-pretty text-balance">
        Illustrative report showing latency, memory, and repeated-query findings.
      </p>
    </div>

    <!-- Screenshot Container (Pure, Single Window Frame) -->
    <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-2xl border border-white/15 bg-[#08090C] shadow-[0_24px_80px_rgba(0,0,0,0.9)] ring-1 ring-white/5">
      <img
        src={cliScreenshot.src}
        alt="Example Pinpoint CLI Report output from a Laravel application"
        width="1200"
        height="750"
        loading="lazy"
        class="w-full h-auto block"
      />
    </div>

    <!-- Verified Real-World Callouts (Positioned Outside Terminal Container) -->
    <div class="mx-auto mt-6 max-w-5xl grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-xl border border-white/10 bg-[#0C0E12] p-5 shadow-lg space-y-2">
        <div class="flex items-center gap-2 text-gray-100 font-semibold text-xs uppercase tracking-wider">
          <AlertTriangle class="h-4 w-4 shrink-0" />
          <span class="leading-none">Critical Bottlenecks</span>
        </div>
        <p class="text-xs leading-relaxed text-gray-300">
          <code class="text-gray-200 font-mono">v1.historical-records.search</code> clocked at <span class="text-rose-400 font-bold">4,350ms</span>, flagged in the red tier.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-[#0C0E12] p-5 shadow-lg space-y-2">
        <div class="flex items-center gap-2 text-gray-100 font-semibold text-xs uppercase tracking-wider">
          <Zap class="h-4 w-4 shrink-0" />
          <span class="leading-none">Repeated Query Alerts</span>
        </div>
        <p class="text-xs leading-relaxed text-gray-300">
          Detects relationship loops and duplicate executions up to <span class="text-rose-400 font-bold">x11 queries</span> per HTTP request.
        </p>
      </div>

      <div class="rounded-xl border border-white/10 bg-[#0C0E12] p-5 shadow-lg space-y-2">
        <div class="flex items-center gap-2 text-gray-100 font-semibold text-xs uppercase tracking-wider">
          <ShieldCheck class="h-4 w-4 shrink-0" />
          <span class="leading-none">Instant Locate Block</span>
        </div>
        <p class="text-xs leading-relaxed text-gray-300">
          The CLI can render route labels and caller locations as terminal links that open your IDE.
        </p>
      </div>
    </div>
  </div>
</section>

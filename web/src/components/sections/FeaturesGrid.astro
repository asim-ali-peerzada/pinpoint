<script>
  function setupScrollytelling() {
    const container = document.getElementById('scrolly-steps');
    if (!container || container.dataset.bound === 'true') return;
    container.dataset.bound = 'true';

    const steps = document.querySelectorAll('.scrolly-step');
    const panelViews = {
      1: document.getElementById('panel-view-1'),
      2: document.getElementById('panel-view-2'),
      3: document.getElementById('panel-view-3'),
      4: document.getElementById('panel-view-4'),
      5: document.getElementById('panel-view-5'),
    };
    const tabBtns = document.querySelectorAll('.step-tab-btn');

    function setActiveStep(stepNum) {
      // Update Tab buttons in sticky header
      tabBtns.forEach((btn) => {
        const target = Number(btn.getAttribute('data-target-step'));
        if (target === stepNum) {
          btn.classList.add('text-white', 'border-brand-accent', 'font-semibold');
          btn.classList.remove('text-gray-400', 'border-transparent');
        } else {
          btn.classList.remove('text-white', 'border-brand-accent', 'font-semibold');
          btn.classList.add('text-gray-400', 'border-transparent');
        }
      });

      // Update Step Cards on Left
      steps.forEach((s) => {
        const num = Number(s.getAttribute('data-step'));
        const badge = s.querySelector('.step-num');
        if (num === stepNum) {
          s.classList.add('border-white/20', 'border-l-brand-accent', 'bg-[#111418]', 'opacity-100', 'shadow-xl');
          s.classList.remove('border-white/[0.08]', 'border-l-transparent', 'bg-[#0D0F12]', 'opacity-60');
          if (badge) {
            badge.classList.add('bg-brand-accent/20', 'text-brand-accent');
            badge.classList.remove('bg-white/[0.05]', 'text-gray-400');
          }
        } else {
          s.classList.remove('border-white/20', 'border-l-brand-accent', 'bg-[#111418]', 'opacity-100', 'shadow-xl');
          s.classList.add('border-white/[0.08]', 'border-l-transparent', 'bg-[#0D0F12]', 'opacity-60');
          if (badge) {
            badge.classList.remove('bg-brand-accent/20', 'text-brand-accent');
            badge.classList.add('bg-white/[0.05]', 'text-gray-400');
          }
        }
      });

      // Switch Panel Views
      Object.entries(panelViews).forEach(([k, el]) => {
        if (!el) return;
        if (Number(k) === stepNum) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    // Click & Keyboard listener on Cards themselves
    steps.forEach((step) => {
      step.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        const num = Number(step.getAttribute('data-step'));
        if (num) setActiveStep(num);
      });
      step.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          if (e.target.closest('a')) return;
          e.preventDefault();
          const num = Number(step.getAttribute('data-step'));
          if (num) setActiveStep(num);
        }
      });
    });

    // Click listener on Tab Buttons
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = Number(btn.getAttribute('data-target-step'));
        if (target) setActiveStep(target);
      });
    });

    // Balanced IntersectionObserver for scroll tracking without jumping
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const step = Number(entry.target.getAttribute('data-step'));
              if (step) setActiveStep(step);
            }
          });
        },
        {
          rootMargin: '-25% 0px -35% 0px',
          threshold: 0.4,
        }
      );

      steps.forEach((step) => observer.observe(step));
    }
  }

  setupScrollytelling();
  document.addEventListener('astro:after-swap', setupScrollytelling);
</script>


---
import { cn } from '../../lib/cn';

interface Props {
  class?: string;
  glow?: boolean;
}

const { class: className, glow = false } = Astro.props;
---

<div class={cn(
  'glass-panel glass-panel-hover rounded-2xl p-6 transition-all duration-300',
  glow && 'hover:border-brand-accent/35',
  className
)}>
  <slot />
</div>

---
import { cn } from '../../lib/cn';

interface Props {
  code: string;
  class?: string;
  filename?: string;
}

const { code, class: className, filename } = Astro.props;
---

<div class={cn('rounded-xl border border-white/10 bg-brand-card overflow-hidden', className)}>
  {filename && (
    <div class="px-4 py-2 text-xs font-mono text-gray-500 border-b border-white/5 bg-white/[0.02]">
      {filename}
    </div>
  )}
  <pre class="p-4 overflow-x-auto text-sm font-mono text-gray-200"><code>{code}</code></pre>
</div>

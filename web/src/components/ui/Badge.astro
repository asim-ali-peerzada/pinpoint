---
import { cn } from '../../lib/cn';

interface Props {
  class?: string;
  variant?: 'default' | 'accent' | 'outline';
}

const { class: className, variant = 'default' } = Astro.props;

const variants = {
  default: 'bg-white/5 text-gray-300 border-white/10',
  accent: 'bg-brand-accent/10 text-brand-accent border-brand-accent/30',
  outline: 'bg-transparent text-gray-400 border-white/10',
};
---

<span class={cn('inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium', variants[variant], className)}>
  <slot />
</span>
